# Large binary assets — kept on disk, not versioned (see README to obtain)
*.wav
*.task

# Python runtime
.venv/
.venv-tts/
__pycache__/
*.pyc

# Backups & editor cruft
*.bak-*
*.bak
.DS_Store

# Hammerspoon Spoons (installed separately)
/Spoons/

# Compiled Swift overlay binary (build from overlay.swift, see README)
apps/noseguard/overlay/overlay

# Local git worktrees (Claude Code / Orca), each its own checkout
/.claude/

# Symlinked in by ~/Github/pipecat-voice-agent/hammerspoon/install.sh; that
# repo owns and versions them
/apps/voice_agent
/lib/voice_toggle.lua
/tests/spec/voice_toggle_spec.lua

# Agent scratch: nested git worktrees, and a symlink into the ignored .claude/
/.worktrees/
/.agents/skills
